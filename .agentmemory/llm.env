# Project-scoped OpenAI-compatible provider for AgentMemory session summaries.
OPENAI_API_KEY=no-key
OPENAI_BASE_URL=http://127.0.0.1:14101/v1
OPENAI_MODEL=gemma4-26b-a4b-ud-q8
MAX_TOKENS=4096
AGENTMEMORY_LLM_TIMEOUT_MS=180000

# Reuse the same OpenAI-compatible Gemma provider for LLM-backed observation
# compression and knowledge-graph entity/relation extraction.
AGENTMEMORY_AUTO_COMPRESS=true
GRAPH_EXTRACTION_ENABLED=true

# OPENAI_API_KEY also activates AgentMemory's OpenAI embedding auto-detection.
# Preserve the Gemini provider that created the existing 768-dimensional index.
EMBEDDING_PROVIDER=gemini

# The backend exposes one inference slot.
SUMMARIZE_CHUNK_SIZE=400
SUMMARIZE_CHUNK_CONCURRENCY=1
