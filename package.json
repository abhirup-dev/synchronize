{
  "name": "synchronize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "synchronize": "./bin/synchronize",
    "synchronize-mcp": "./bin/synchronize-mcp"
  },
  "scripts": {
    "daemon": "bun run src/daemon.ts",
    "mcp": "bun run src/mcp.ts",
    "synchronize": "bun run src/cli.ts",
    "ui:probe": "bun run tools/ui-probe/run.ts",
    "ui:probe:demo": "bun run tools/ui-probe/run.ts --mode demo --target chrome",
    "ui:probe:demo:chrome": "bun run tools/ui-probe/run.ts --mode demo --target chrome",
    "ui:probe:demo:iab:prepare": "bun run tools/ui-probe/run.ts --mode demo --target codex-iab --keep-daemon",
    "ui:probe:flows": "bun run tools/ui-probe/flowbook.ts check",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "3.6.0",
    "@playwright/mcp": "0.0.76",
    "@playwright/test": "1.61.0",
    "@types/bun": "^1.2.0",
    "chrome-devtools-mcp": "1.3.0",
    "libretto": "0.6.31",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.191"
  }
}
