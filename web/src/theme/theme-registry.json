{
  "$description": "DTCG-shaped source of truth for Synchronize UI theme and skin identities. Token values still live in styles/tokens.css until the value registry migration lands.",
  "defaults": {
    "$type": "synchronize.defaults",
    "$value": {
      "initialTheme": "sigil-dark",
      "initialSkin": "sigil",
      "lightTheme": "sigil-light",
      "darkTheme": "sigil-dark"
    }
  },
  "theme": {
    "sigil-light": {
      "$type": "synchronize.theme",
      "$value": "sigil-light",
      "$extensions": {
        "synchronize": {
          "label": "Light",
          "family": "light",
          "toolbarOrder": 0,
          "normalizes": ["light", "rose-pine-dawn"]
        }
      }
    },
    "sigil-dark": {
      "$type": "synchronize.theme",
      "$value": "sigil-dark",
      "$extensions": {
        "synchronize": {
          "label": "Dark",
          "family": "dark",
          "toolbarOrder": 1,
          "normalizes": ["dark", "kanagawa-wave", "catppuccin-mocha"]
        }
      }
    }
  },
  "skin": {
    "sigil": {
      "$type": "synchronize.skin",
      "$value": "sigil",
      "$extensions": {
        "synchronize": {
          "label": "Sigil",
          "toolbarOrder": 0
        }
      }
    }
  }
}
