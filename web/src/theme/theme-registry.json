{
  "$description": "DTCG-shaped source of truth for Synchronize UI theme and skin identities. Token values still live in styles/tokens.css until the value registry migration lands.",
  "defaults": {
    "$type": "synchronize.defaults",
    "$value": {
      "initialTheme": "kanagawa-wave",
      "initialSkin": "brutal",
      "lightTheme": "light",
      "darkTheme": "kanagawa-wave"
    }
  },
  "theme": {
    "light": {
      "$type": "synchronize.theme",
      "$value": "light",
      "$extensions": {
        "synchronize": {
          "label": "Light",
          "family": "light",
          "toolbarOrder": 0,
          "normalizes": []
        }
      }
    },
    "kanagawa-wave": {
      "$type": "synchronize.theme",
      "$value": "kanagawa-wave",
      "$extensions": {
        "synchronize": {
          "label": "Kanagawa Wave",
          "family": "dark",
          "toolbarOrder": 1,
          "normalizes": ["dark", "catppuccin-mocha"]
        }
      }
    },
    "rose-pine-dawn": {
      "$type": "synchronize.theme",
      "$value": "rose-pine-dawn",
      "$extensions": {
        "synchronize": {
          "label": "Rose Pine Dawn",
          "family": "light",
          "toolbarOrder": 2,
          "normalizes": []
        }
      }
    }
  },
  "skin": {
    "brutal": {
      "$type": "synchronize.skin",
      "$value": "brutal",
      "$extensions": {
        "synchronize": {
          "label": "Brutal",
          "toolbarOrder": 0
        }
      }
    },
    "glass": {
      "$type": "synchronize.skin",
      "$value": "glass",
      "$extensions": {
        "synchronize": {
          "label": "Glass",
          "toolbarOrder": 1
        }
      }
    }
  }
}
