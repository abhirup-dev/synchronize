{
  "name": "@synchronize/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neo-brutalist web chat UI for the synchronize agent messaging bus",
  "scripts": {
    "build": "bun run build.ts",
    "dev:raw": "vite --config vite.dev.config.ts",
    "generate:theme-registry": "bun run scripts/generate-theme-registry.mjs",
    "check:theme-registry": "bun run scripts/generate-theme-registry.mjs --check",
    "check:theme-contract": "bun run check:theme-registry && bun run scripts/check-theme-contract.mjs",
    "check:theme-contract:strict": "bun run check:theme-registry && bun run scripts/check-theme-contract.mjs --strict",
    "audit:class-strings": "bun run scripts/audit-class-strings.mjs",
    "typecheck": "tsc --noEmit -p .",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:headed": "vitest --project storybook --browser.headless=false",
    "test:storybook:ui": "vitest --project storybook --ui"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@tanstack/react-virtual": "^3.13.25",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "bun-types": "^1.3.14",
    "playwright": "^1.61.0",
    "postcss": "^8.5.15",
    "storybook": "^10.4.6",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
