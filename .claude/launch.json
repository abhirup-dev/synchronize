{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "cwd": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "storybook"],
      "port": 6006,
      "autoPort": false
    },
    {
      "name": "synchronize-daemon",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "src/daemon.ts"],
      "port": 47823,
      "autoPort": false,
      "env": {
        "SYNCHRONIZE_PORT": "47823",
        "SYNCHRONIZE_HOME": "/tmp/synchronize-preview"
      }
    },
    {
      "name": "synchronize-real",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "src/daemon.ts"],
      "port": 58405,
      "env": {
        "SYNCHRONIZE_PORT": "58405"
      }
    }
  ]
}
