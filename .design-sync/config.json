{
  "pkg": "@synchronize/web",
  "globalName": "SynchronizeWeb",
  "projectId": "41739566-4de3-4dda-90bc-a7777d50b42d",
  "shape": "storybook",
  "storybookConfigDir": "web/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "entry": "./web/.ds-entry.tsx",
  "extraEntries": ["./.ds-entry.tsx", "./.ds-providers.tsx"],
  "provider": {
    "component": "DataSourceProvider",
    "props": { "value": { "$ref": "mockDataSource" } },
    "inner": {
      "component": "ContextMenuProvider",
      "inner": {
        "component": "ToastProvider",
        "inner": { "component": "ArchiveRecoveryProvider" }
      }
    }
  },
  "storyImports": {
    "shim": ["/components/Toast.tsx", "/components/ContextMenu.tsx", "/components/ArchiveRecovery.tsx"]
  },
  "overrides": {
    "ActivityView": { "cardMode": "column" },
    "RoomHeader": { "cardMode": "column" },
    "ResizeHandle": { "cardMode": "column" },
    "ChatView": { "cardMode": "column" },
    "ChatViewDark": { "cardMode": "column" },
    "ActivityViewDark": { "cardMode": "column" },
    "ScrollControls": { "cardMode": "column" },
    "ThreadSummaryPanel": { "cardMode": "column" },
    "ContextMenuProvider": { "cardMode": "column", "skip": ["surfaces-contextmenu--message-actions"] },
    "ToastProvider": { "skip": ["surfaces-toast--fires-success", "surfaces-toast--fires-error"] },
    "AgentColorPicker": { "cardMode": "single", "primaryStory": "CustomColor" },
    "Markdown": { "skip": ["messages-markdown--empty"] },
    "SpawnAgentDialog": {
      "skip": [
        "agent-states-spawnagentdialog--default",
        "agent-states-spawnagentdialog--no-launch-config",
        "agent-states-spawnagentdialog--runtime-unavailable",
        "agent-states-spawnagentdialog--name-required-validation"
      ]
    }
  },
  "titleMap": {
    "ArchiveRecovery": "ArchiveRecoveryProvider",
    "ContextMenu": "ContextMenuProvider",
    "Toast": "ToastProvider",
    "Identity": "IdentityBadge",
    "ChatSurface": null,
    "AppShell": null,
    "SynchronizeUI": null
  },
  "buildCmd": "cd web && ./node_modules/.bin/storybook build -c .storybook -o ../.design-sync/sb-reference",
  "readmeHeader": ".design-sync/conventions.md"
}
